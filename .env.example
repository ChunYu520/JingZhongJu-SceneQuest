# App
NODE_ENV=development
WEB_ORIGIN=http://localhost:3001
API_PORT=3001
API_HOST=0.0.0.0
PUBLIC_API_BASE_URL=http://localhost:3001

# PostgreSQL
DATABASE_URL=postgresql://scenequest:scenequest_dev_password@localhost:5432/scenequest?schema=public

# Authentication / Admin
TOKEN_PEPPER=replace_with_a_long_random_secret
ADMIN_TOKEN=replace_with_a_long_random_admin_secret
ADMIN_DEBUG_ENABLED=false
# 本地开发可以首次在后台设置管理员口令；生产环境必须预先提供强随机 ADMIN_TOKEN。
SESSION_TTL_HOURS=24

# AI provider — OpenAI-compatible chat completions endpoint
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://example-provider.invalid/v1
AI_API_KEY=replace_me
AI_MODEL=replace_with_available_model
AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=1
AI_TEMPERATURE=0.3
AI_VISION_MODEL=
AI_JUDGE_TIMEOUT_MS=35000

# AI 配置可在管理员后台设置，也可直接填写此服务端 .env。API Key 不能放入网页代码。
# AI_VISION_MODEL 需支持图像输入；不填时后端回退到 AI_MODEL。
# 服务端会从 OpenStreetMap/Nominatim 和 Overpass 自动搜索所选景区的真实公开点位。
# 可选配置 Tavily 扩充景区网页资料；不配置时仍使用 OpenStreetMap 地图发现。
TAVILY_API_KEY=replace_me
TAVILY_BASE_URL=https://api.tavily.com/search
OVERPASS_URL=https://overpass-api.de/api/interpreter
DISCOVERY_RADIUS_METERS=1800
DISCOVERY_TIMEOUT_MS=18000

# Logs / data lifecycle
LOG_LEVEL=info
SESSION_RETENTION_HOURS=24
