# ---- 依赖 ----
node_modules/
packages/*/node_modules/
apps/*/node_modules/

# ---- 环境变量与密钥（绝不入库）----
.env
.env.*
!.env.example
deploy/windows/.env.production

# ---- 运行期数据与日志 ----
runtime/
tmp/
logs/
*.log

# ---- 本地生成/打包产物（可由源码重建，不纳入版本库）----
dist/
coverage/
output/
build/
*.zip

# ---- 编辑器 / 操作系统 ----
.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
